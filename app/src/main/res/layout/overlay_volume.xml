<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="end|center_vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingEnd="@dimen/overlay_panel_margin">

    <LinearLayout
        android:id="@+id/overlayPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_overlay"
        android:elevation="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/overlay_panel_padding_h"
        android:paddingVertical="@dimen/overlay_panel_padding_v">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="@dimen/overlay_close_size"
            android:layout_height="@dimen/overlay_close_size"
            android:background="@android:color/transparent"
            android:contentDescription="@string/overlay_close"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close" />

        <TextView
            android:id="@+id/overlaySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxWidth="160dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/sliderContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="bottom"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/overlayMoreCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
